## 10. Dictionary App

```
import { useState } from "react";
export default function App() {
  const [word, setWord] = useState("");
  const [meaning, setMeaning] = useState("");
  return <div>
    <h2>Dictionary</h2>
    <input onChange={e => setWord(e.target.value)} />
    <button onClick={() => fetch("https://api.dictionaryapi.dev/api/v2/entries/en/" + word)
      .then(r => r.json()).then(d => setMeaning(d[0].meanings[0].definitions[0].definition))
      .catch(() => setMeaning("Word not found"))}>Search</button>
    <p>{meaning}</p>
  </div>;
}
```

