## 1. To-Do List

```
import { useState } from "react";
export default function App() {
  const [task, setTask] = useState("");
  const [list, setList] = useState([]);
  return <div>
    <h2>To-Do List</h2>
    <input onChange={e => setTask(e.target.value)} />
    <button onClick={() => setList([...list, task])}>Add</button>
    {list.map((t, i) => <p key={i}>{t}</p>)}
  </div>;
}
```

## 2. Calculator

```
import { useState } from "react";
export default function App() {
  const [a, A] = useState(0);
  const [b, B] = useState(0);
  const [r, R] = useState(0);
  return <div>
    <h2>Calculator</h2>
    <input type="number" onChange={e => A(+e.target.value)} />
    <input type="number" onChange={e => B(+e.target.value)} />
    <button onClick={() => R(a + b)}>Add</button>
    <button onClick={() => R(a - b)}>Subtract</button>
    <h3>Result: {r}</h3>
  </div>;
}
```

